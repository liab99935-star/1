# ============================================
# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤,
# 실제 발급받은 값으로 채워 넣으세요.
# (.env 파일은 git에 올라가지 않습니다 - .gitignore 처리됨)
# ============================================

# --- 텍스트 생성 AI (블로그 글 / 인스타 캡션) ---
# https://platform.openai.com/api-keys 에서 발급 (ChatGPT 무료/Plus 구독과는 별개로,
# API는 사용한 만큼 과금되는 별도 상품입니다. 소액 충전 후 사용)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 네이버 블로그 자동 업로드 ---
# https://developers.naver.com/apps 에서 애플리케이션 등록
# "네이버 로그인" + "블로그" API 사용 설정 필요
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# scripts/get_naver_token.py 실행해서 아래 값을 자동으로 채우세요
NAVER_ACCESS_TOKEN=
NAVER_BLOG_ID=
# 네이버 파트너스(제휴) 가입 후 발급되는 ID. 없으면 비워두면 일반 쇼핑 링크로 대체됩니다.
NAVER_PARTNER_ID=

# --- 블로그 본문 이미지 ---
# https://pixabay.com/api/docs/ 가입 후 무료 발급
PIXABAY_API_KEY=

# --- 하루 발행 개수 ---
POSTS_PER_DAY=15

# --- AI 영상 생성 (아직 서비스 미정 상태면 비워두세요. MOCK 모드로 동작합니다) ---
VIDEO_PROVIDER=mock
# Runway 사용 시
RUNWAY_API_KEY=
# Luma Dream Machine 사용 시
LUMA_API_KEY=
# Kling AI 사용 시
KLING_API_KEY=
